{
  "name": "razorgrowth-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vaanigam \u2014 a merchant-side gateway making any Razorpay merchant safely payable by any AI buyer agent, on any protocol (Track 01).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "postinstall": "pnpm --filter @razorgrowth/domain run build && pnpm --filter @razorgrowth/contracts run build",
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "dev:api": "pnpm --filter @razorgrowth/api run dev",
    "dev:web": "pnpm --filter @razorgrowth/web run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint && eslint --config eslint.config.js scripts",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "db:up": "node scripts/db-up.mjs",
    "db:up:once": "node scripts/db-server.mjs",
    "db:migrate": "pnpm --filter @razorgrowth/api run db:migrate",
    "db:generate": "pnpm --filter @razorgrowth/api run db:generate",
    "db:seed": "pnpm --filter @razorgrowth/api run db:seed",
    "db:reset": "pnpm --filter @razorgrowth/api run db:reset",
    "eval:intent": "pnpm --filter @razorgrowth/api run eval:intent",
    "eval:recommendation": "pnpm --filter @razorgrowth/api run eval:recommendation",
    "demo": "pnpm --filter @razorgrowth/api run demo:simulate",
    "demo:simulate": "pnpm --filter @razorgrowth/api run demo:simulate",
    "demo:golden-path": "pnpm --filter @razorgrowth/api run demo:golden-path",
    "demo:agent-swarm": "pnpm --filter @razorgrowth/api run demo:agent-swarm",
    "redteam": "pnpm --filter @razorgrowth/api run redteam"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@electric-sql/pglite-socket": "^0.2.10",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2"
  }
}
