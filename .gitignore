# dependencies
node_modules/
.pnpm-store/

# env
.env
.env.local
.env.*.local

# build output
dist/
build/
.turbo/
*.tsbuildinfo

# Local dev databases (PGlite data directories — see scripts/db-server.mjs).
#
# The glob matters: only `.dbdata/` was ignored, so every sibling created
# for a test or verification run — .dbdata-local, .dbdata-qa,
# .dbdata-verification-* — was tracked instead. That put ~3,500 binary
# PGlite files in the repository, and those files ARE the demo database:
# merchant password hashes and live session tokens included. None of it
# belongs in version control.
.dbdata/
.dbdata-*/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS junk
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# test / coverage
coverage/

# Prisma
apps/api/prisma/dev.db

# Throwaway query/repair scripts written while auditing against a live
# database. Useful in the moment, never part of the product.
.qa/
.p18/
apps/api/.scratch/

# Vite/Vitest write these transient config shims next to the real config.
*.timestamp-*.mjs
