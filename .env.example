# Copy this file to .env and fill in real values for local development.
# Never commit .env or any file containing real secrets.

# --- Core ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Database ---
# Local dev: served by `pnpm db:up` (scripts/db-server.mjs), a PGlite
# instance speaking the real Postgres wire protocol on this port — see
# that file for why. `pgbouncer=true` tells Prisma to skip named prepared
# statements, which PGlite-socket's single shared session does not isolate
# per connection the way real Postgres backends do (the same flag Prisma
# recommends for real PgBouncer transaction-pooling mode, for the same
# reason). If you see "Can't reach database server" errors after a long
# dev session, the PGlite process itself has likely degraded (observed
# during PART 02 development, cause unconfirmed — not a Prisma config
# issue) — just restart `pnpm db:up`, no data is lost. Point this at any
# real PostgreSQL server instead (Docker, managed, on-prem) with no code
# changes — just drop the query params.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable&pgbouncer=true&connection_limit=5

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Razorpay Test Mode (PART 07) ---
# Optional, but must be set as a complete set (all three or none) — the
# server fails fast at startup on a partial configuration. Unset by
# default: real payment initiation returns a safe "not configured" error
# while the rest of the app (catalog, agents, commerce through
# READY_FOR_PAYMENT) still works. Use ONLY Razorpay Test Mode keys
# (https://dashboard.razorpay.com/app/keys, Test Mode toggle) — never a
# live/production key. The automated test suite never reads these; it
# always uses the deterministic MockPaymentGateway regardless of what is
# set here.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
# RAZORPAY_TIMEOUT_MS=10000

# --- Merchant identity/auth (PART 10) ---
# How long an issued session token stays valid before a merchant user
# must log in again. Sessions are server-side and revocable (a logout
# deletes the row) — this is the fallback expiry for one that's never
# explicitly logged out.
SESSION_VALIDITY_HOURS=12

# --- Buyer Agent AI provider (PART 03) ---
# Optional. Unset by default: the Buyer Agent falls back to a clearly
# labeled deterministic rule-based extractor/ranker (aiProviderMode:
# "DEMO_RULE_BASED" in every response), so the golden-path demo works with
# zero network dependency and zero cost. Set AI_PROVIDER_API_KEY to a real
# Anthropic API key to exercise live LLM-backed intent extraction and
# recommendation ranking (aiProviderMode: "LIVE_ANTHROPIC") instead.
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_MODEL=claude-haiku-4-5-20251001
# AI_PROVIDER_TIMEOUT_MS=8000

# =====================================================================
# PRODUCTION DEPLOYMENT
# =====================================================================
# Everything above is written for local development. For a real
# deployment see docs/DEPLOYMENT.md. The differences that matter:
#
#   NODE_ENV=production
#   PORT=4000                      (or whatever your platform injects)
#   LOG_LEVEL=info
#
#   WEB_ORIGIN                     MUST be the exact public origin of the
#                                  frontend, e.g. https://app.example.com
#                                  — it is the CORS allowlist. A wrong
#                                  value blocks every browser request.
#
#   DATABASE_URL                   A REAL managed Postgres URL. Drop the
#                                  local dev query params and use TLS:
#                                  postgresql://USER:PASS@HOST:5432/DB?sslmode=require
#                                  If your provider front-ends with a
#                                  transaction pooler (Neon pooled,
#                                  Supabase pgbouncer, RDS Proxy), keep
#                                  ?pgbouncer=true&connection_limit=<n>.
#
#   VITE_API_BASE_URL              Baked in at BUILD time, not runtime.
#                                  Setting it on a running container does
#                                  nothing — pass it as a Docker build
#                                  arg. See apps/web/Dockerfile.
#
#   RAZORPAY_*                     Test Mode keys first. Only switch to
#                                  live keys after a full Test Mode run.
#                                  The webhook secret must match the one
#                                  configured in the Razorpay dashboard
#                                  for your webhook URL.
#
#   SESSION_VALIDITY_HOURS         Consider lowering for production.
#
# Do NOT deploy a .env file. Inject these from your platform's secret
# store (Fly secrets, Render env groups, AWS Secrets Manager, etc.) —
# .dockerignore deliberately excludes .env so it can never be baked into
# an image layer.
