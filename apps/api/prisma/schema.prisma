// RazorGrowth AI — relational schema (PART 00 §37; PART 01 §9).
//
// Financial amounts are always stored as integer minor units (`*Minor`
// Int columns) paired with a `Currency` enum column — never as floats,
// never as a formatted string (PART 00 §16). Historical order/payment
// rows snapshot the price and display text that were true at the time,
// rather than depending on current catalog data to reconstruct past
// financial truth (PART 00 §37; PART 01 §14).

generator client {
  provider      = "prisma-client-js"
  // `native` keeps local development working on any OS. The Debian
  // target is required because the production image is Debian-slim —
  // without it, Prisma generates only the host's engine and the
  // container fails at runtime with "query engine not found". Both are
  // listed so the same schema builds locally and in Docker.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need session-level advisory locks, which a transaction
  // pooler (Supabase pooler, PgBouncer, RDS Proxy) cannot provide. When
  // DATABASE_URL points at a pooled endpoint, DIRECT_URL must point at
  // the direct one so `prisma migrate deploy` works. For local
  // development both are simply the same URL.
  directUrl = env("DIRECT_URL")
}

enum Currency {
  INR
  USD
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
}

enum MerchantUserRole {
  OWNER
  APPROVER
  VIEWER
  CUSTOMER
  PLATFORM_ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

/// PART 06 §13 — `CHECKED_OUT` (PART 01 placeholder, never referenced by
/// any code) renamed to `CONVERTED` and `CHECKOUT_PENDING`/`EXPIRED` added
/// to match the real deterministic lifecycle `@razorgrowth/domain`
/// `CART_TRANSITIONS` now enforces.
enum CartStatus {
  ACTIVE
  CHECKOUT_PENDING
  CONVERTED
  EXPIRED
  ABANDONED
}

/// PART 06 §34 — `PAYMENT_PENDING` added for PART 07 forward-compatibility
/// only; nothing in PART 06 ever sets it. `PENDING` (PART 01) doubles as
/// PART 06's "order created, no payment attempted" state.
enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  FAILED
  CANCELLED
}

/// PART 06 §39-§40 — RazorGrowth's own internal commerce checkout state,
/// explicitly NOT Razorpay Checkout. PART 06 only ever exercises
/// `CREATED -> READY_FOR_PAYMENT` (plus `CANCELLED`/`EXPIRED`);
/// `PAYMENT_IN_PROGRESS`/`COMPLETED`/`FAILED` exist for PART 07.
enum CheckoutSessionStatus {
  CREATED
  READY_FOR_PAYMENT
  PAYMENT_IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

/// PART 00 §12 — deterministic payment state machine states. Transition
/// legality is enforced in application code (`@razorgrowth/domain`
/// `transitionPaymentState`), never by ad-hoc writes.
enum PaymentState {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  UNKNOWN
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CustomerDebitStatus {
  UNKNOWN
  NOT_DEBITED
  DEBITED
}

enum MerchantCreditStatus {
  UNKNOWN
  NOT_CREDITED
  CREDITED
}

/// PART 01 §77 — `DEMO` marks seeded/synthetic payment history so it can
/// never be mistaken for a real Razorpay Test Mode transaction.
/// PART 07 §10, §18 adds the real `MOCK` provider (the deterministic test
/// double used by the automated test suite — distinct from `DEMO` seed
/// data and from a real `RAZORPAY` Test Mode transaction, so all three can
/// never be confused with one another).
enum PaymentProvider {
  DEMO
  RAZORPAY
  MOCK
  X402
}

enum PaymentEventProcessingStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED_PROCESSING
  UNRESOLVED
  REJECTED_SIGNATURE
}

/// PART 05 §53 adds `MERCHANT_USER` — the human approver. `POLICY_ENGINE`
/// is deterministic application code, never an AI actor; only
/// `BUYER_AGENT`/`MERCHANT_AGENT` are real AI agents (PART 00 §6).
enum AgentActorType {
  BUYER_AGENT
  MERCHANT_AGENT
  POLICY_ENGINE
  MERCHANT_USER
  CUSTOMER
  SYSTEM
  /// PART 06 §85 — the deterministic commerce execution engine
  /// (cart/order/checkout creation). Distinct from `SYSTEM` so the ledger
  /// can show precisely which deterministic subsystem acted; never an AI
  /// actor.
  COMMERCE
  /// PART 07 §75 — the deterministic payment orchestration engine
  /// (initiation, client-verification handling, reconciliation). Distinct
  /// from `SYSTEM`/`COMMERCE` so the ledger shows precisely which
  /// deterministic subsystem acted; never an AI actor.
  PAYMENT_SYSTEM
  /// PART 07 §75 — attributed to Razorpay itself only for events whose
  /// content ORIGINATED from Razorpay (a verified webhook delivery). Never
  /// used for anything this application's own code decided — that is
  /// always `PAYMENT_SYSTEM`.
  RAZORPAY
}

/// PART 00 §11 — approval status lifecycle, not a boolean.
enum AgentActionStatus {
  PROPOSED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
  VERIFIED
}

/// PART 05 §7 — the closed outcome vocabulary a `PolicyEvaluation` row (and
/// the legacy `AgentAction.policyDecision` summary field) may hold.
enum PolicyDecision {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

/// PART 05 §29 — a human approval decision. Distinct from `PolicyDecision`:
/// policy says what MAY happen, approval says what a human actually DECIDED.
enum ApprovalDecision {
  APPROVED
  REJECTED
}

/// PART 05 §37-§38. `ACTIVE` is the only status PART 06/07 may execute
/// against; every other status must be rejected by the future execution
/// layer. `CONSUMED` is reserved for PART 06 to set — PART 05 never sets it
/// (§45: "there is no execution yet").
enum ExecutionAuthorizationStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

enum OpportunityCategory {
  CROSS_SELL
  UPSELL
  CATALOG_GAP
  READINESS_GAP
  PAYMENT_RECOVERY
}

enum OpportunityStatus {
  IDENTIFIED
  PROPOSED
  ACTED_ON
}

/// PART 02 §57 — merchant-authored eligibility for a FUTURE offer. This is
/// NOT an authorization to discount; actual offer approval remains the
/// Policy Engine's job (PART 05). `UNKNOWN` is a real state, not a
/// default "no".
enum PromotionEligibility {
  ELIGIBLE
  INELIGIBLE
  UNKNOWN
}

/// PART 02 §36 — merchant-level Agentic Readiness level, derived
/// deterministically from `ReadinessSnapshot.overallScore` via
/// `@razorgrowth/domain` `deriveReadinessLevel`.
enum MerchantReadinessLevel {
  AGENT_READY
  NEARLY_READY
  PARTIALLY_READY
  NOT_READY
}

/// PART 00 §19, §29, §78 — every revenue figure carries this tag so
/// observed, estimated, and opportunity values are never conflated.
enum ValueClassification {
  OBSERVED
  ESTIMATED
  OPPORTUNITY
}

/// PART 03 §145 — deliberately small; the payment state machine (PART 07)
/// is where real transition rigor belongs, not buyer conversation state.
enum BuyerConversationStatus {
  ACTIVE
  AWAITING_CLARIFICATION
  RECOMMENDATION_READY
  CLOSED
}

enum BuyerMessageRole {
  BUYER
  AGENT
}

/// PART 04 §10, §17, §24, §37, §50, §61 — Merchant Agent growth taxonomy.
/// Small, explicit, closed vocabularies only — never an open string a
/// model can extend.
enum GrowthActionType {
  CROSS_SELL
  UPSELL
  BUNDLE
  BOUNDED_OFFER
  RECOVERY
}

/// PART 04 ends at proposal creation/validation (`PROPOSED` /
/// `REJECTED_VALIDATION`). PART 05 §26-§28 adds the real governance
/// lifecycle: PROPOSED -> POLICY_DENIED | ALLOWED | PENDING_APPROVAL ->
/// APPROVED | APPROVAL_REJECTED -> AUTHORIZED. See `@razorgrowth/domain`
/// `GROWTH_PROPOSAL_TRANSITIONS` for the authoritative transition table
/// shared between the API layer and tests.
/// The full lifecycle of one governed agent action.
///
/// PROPOSED -> PENDING_APPROVAL -> APPROVED -> EXECUTED -> VERIFIED,
/// or REJECTED / FAILED.
///
/// WHY EXECUTED AND VERIFIED ARE HERE NOW
///
/// Governance used to end at AUTHORIZED, on the reasoning that execution
/// outcome lives on the rows execution writes (a checkout, a payment) and
/// duplicating it would create a second truth. That reasoning holds for
/// the AMOUNTS and it does not hold for the STATE: with no terminal
/// status, an authorization that was issued and then failed was
/// indistinguishable from one still waiting to run, and "what did the
/// agent actually do" could not be answered from the governance rows
/// alone. It had to be reassembled by joining to whatever each action
/// type happened to write.
///
/// So the terminal states record WHAT HAPPENED, never how much money moved.
/// VERIFIED means the row execution claimed to write was read back and
/// exists — not that revenue arrived.
enum GrowthProposalStatus {
  PROPOSED
  REJECTED_VALIDATION
  POLICY_DENIED
  ALLOWED
  PENDING_APPROVAL
  APPROVED
  APPROVAL_REJECTED
  AUTHORIZED
  /// Execution ran and reported success.
  EXECUTED
  /// The row execution claimed to write was read back and exists.
  VERIFIED
  /// Execution ran and did not complete. Terminal: a failed action is
  /// re-proposed as new work, never silently retried under the same
  /// authorization.
  FAILED
}

enum GrowthProposalMode {
  AI_PROPOSED
  DETERMINISTIC_RELATIONSHIP
  DETERMINISTIC_FALLBACK
  NO_OPPORTUNITY
  BLOCKED_BY_DATA
}

enum ProductRelationshipType {
  COMPLEMENTARY
  UPSELL_ALTERNATIVE
  SIMILAR
  BUNDLE_COMPATIBLE
}

/// PART 04 §25 — AI-suggested relationships are never treated as
/// merchant truth; provenance is always recorded.
enum RelationshipProvenance {
  MERCHANT_CONFIGURED
  CATALOG_METADATA
  SYSTEM_DERIVED
  DEMO_SEED
}

enum OfferKind {
  PERCENTAGE
  FIXED_AMOUNT
}

model Merchant {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  description      String?
  defaultCurrency  Currency       @default(INR)
  businessCategory String
  status           MerchantStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  policy                  MerchantPolicy?
  products                Product[]
  customers               Customer[]
  carts                   Cart[]
  orders                  Order[]
  agentActions            AgentAction[]
  readinessSnapshots      ReadinessSnapshot[]
  recommendationRecords   RecommendationRecord[]
  growthConfig            MerchantGrowthConfig?
  productRelationships    ProductRelationship[]
  growthActionProposals   GrowthActionProposal[]
  policyEvaluations       PolicyEvaluation[]
  approvals               Approval[]
  executionAuthorizations ExecutionAuthorization[]
  checkoutSessions        CheckoutSession[]
  idempotencyRecords      IdempotencyRecord[]
  payments                Payment[]
  paymentProviderEvents   PaymentProviderEvent[]
  merchantUsers           MerchantUser[]

  // Vaanigam gateway — agent-facing commerce.
  agentIdentities      AgentIdentity[]
  spendMandateNonces   SpendMandateNonce[]
  agentGatewayPolicy   AgentGatewayPolicy?
  decisionRecords      DecisionRecord[]
  acpCheckoutSessions  AcpCheckoutSession[]
  acpDelegatedPayments AcpDelegatedPayment[]
  catalogCompilations  CatalogCompilation[]
  campaigns            Campaign[]
  refunds              Refund[]
  returnRequests       ReturnRequest[]
  fulfillments         Fulfillment[]
  disputes             Dispute[]
}

/// PART 10 §1 — a real, authenticated user scoped to exactly one
/// merchant (multi-tenant: a request authenticated as this user can only
/// ever act on `merchantId`, never any other merchant's data). Password
/// hashing uses Node's built-in `crypto.scrypt` (`auth/password.ts`) —
/// no new external dependency for something this codebase can implement
/// correctly with what's already in the runtime.
model MerchantUser {
  id           String           @id @default(uuid())
  merchantId   String
  merchant     Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  email        String           @unique
  passwordHash String
  role         MerchantUserRole @default(OWNER)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  /// Set for, and only for, a user whose role is CUSTOMER. A shopper
  /// signs in through the same table as a merchant user — that part is
  /// unchanged — but the id their SHOPPING data is partitioned by now
  /// lives here, in a table that is not a seller.
  customerAccountId String?          @unique
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  sessions  Session[]
  approvals Approval[]

  @@index([merchantId])
}

/// The shopper, as a first-class row.
///
/// WHAT THIS REPLACED, AND WHY IT MATTERED
///
/// A shopper used to BE a merchant: a `MerchantUser` with role CUSTOMER
/// inside a synthetic merchant, whose merchant id was then used as the
/// partition key for their spending policy and their buyer-agent
/// conversations. One column, `merchantId`, therefore carried two
/// unrelated meanings depending on which row you were looking at — the
/// seller in a purchase, or the shopper doing the purchasing.
///
/// That is not a tidiness complaint. `BuyerConversation.merchantId` held
/// 66 rows keyed by a shopper and 8 keyed by a seller at the time this
/// was written, and the AI Buyer Readiness score counted conversations
/// with `where: { merchantId }` meaning the SELLER — so it scored a
/// merchant on rows that only ever existed because a test wrote them,
/// while every real conversation was invisible to it. A column that means
/// two things will eventually be read as the wrong one.
///
/// Ids are preserved from the synthetic merchant they replaced, so
/// `DecisionRecord.protocolActorRef` — a free-form actor reference with
/// no foreign key — keeps pointing at the same shopper without a rewrite.
model CustomerAccount {
  id          String   @id @default(uuid())
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           MerchantUser?
  spendingPolicy BuyerSpendingPolicy?
  conversations  BuyerConversation[]
}

/// PART 10 §1 — an opaque, server-side, revocable session (not a JWT):
/// the client holds only a random bearer token; this table holds a
/// SHA-256 hash of it (never the raw token, so a leaked database dump
/// alone cannot be replayed) plus expiry. Revoking access is a `DELETE`,
/// not "wait for the JWT to expire."
model Session {
  id             String       @id @default(uuid())
  tokenHash      String       @unique
  merchantUserId String
  merchantUser   MerchantUser @relation(fields: [merchantUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  @@index([merchantUserId])
  @@index([expiresAt])
}

/// Deterministic policy configuration read by the real Policy Engine
/// (PART 00 §9-§11; PART 05 §11-§13, §47). This model is data only — no
/// decision logic lives here (`@razorgrowth/domain` `evaluatePolicy` is the
/// decision logic). `maxDiscountBps` is a hard ceiling (never exceedable,
/// even with approval); `autoApprovalDiscountBps` is the lower autonomous
/// threshold below which no human gate is needed — these are deliberately
/// two different numbers (PART 05 §10), not a single "the" limit as the
/// PART 01 placeholder shape had. `policyVersion` increments on every edit
/// (PART 05 §12) so a decision evaluated under an old version can never
/// silently authorize execution under a materially different one.
model MerchantPolicy {
  merchantId                   String   @id
  merchant                     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  policyVersion                Int      @default(1)
  currency                     Currency @default(INR)
  maxDiscountBps               Int
  autoApprovalDiscountBps      Int
  maxOrderAmountMinor          Int
  autoApprovalOrderAmountMinor Int
  maxRecoveryAttempts          Int

  // ── PART 08 — the boundaries that were missing ────────────────────
  //
  // Six of the nine automation boundaries a merchant is entitled to set
  // either did not exist or lived in `MerchantGrowthConfig`, a second
  // table the Policy Engine did not read as policy. Every one of these is
  // enforced in `evaluatePolicy`, which is a pure function the API calls
  // before anything executes — never in the console.

  /// Minimum gross margin the agent must leave on a discounted line, in
  /// basis points. A discount that would sell below this is DENIED, not
  /// sent for approval: margin floors are the boundary a merchant sets
  /// precisely so nobody has to think about it case by case.
  ///
  /// Enforced only where cost is KNOWN. A variant with no `costMinor`
  /// yields no margin fact, and the engine refuses to invent one — see
  /// `marginBps: null` in the evaluation input.
  minMarginBps                 Int      @default(1000)

  /// Hard ceiling on actions the agent may take UNATTENDED in one UTC day.
  ///
  /// The control that matters most once cycles run on a schedule: every
  /// other limit bounds one action's size, and this bounds how many an
  /// unattended agent can take before a human sees any of them. Counted
  /// from authorizations actually issued, not from proposals raised — a
  /// proposal that policy denied consumed no autonomy.
  maxAutonomousActionsPerDay   Int      @default(50)

  /// Whether the agent may attempt payment recovery at all. Distinct from
  /// `maxRecoveryAttempts`, which bounds retries per order once recovery
  /// is permitted: a merchant may want zero automated retries without
  /// setting a limit of zero and leaving the intent ambiguous.
  recoveryEnabled              Boolean  @default(true)

  /// Action types the agent may NEVER take, whatever else would permit
  /// them. A denylist rather than the absence of an allow: a prohibition
  /// should survive someone later enabling the feature elsewhere.
  ///
  /// string[] of GrowthActionType. Empty means nothing is prohibited.
  prohibitedActions            Json     @default("[]")

  /// Product categories the agent may act on. EMPTY MEANS ALL — the same
  /// convention `BuyerSpendingPolicy.allowAllCategories` was introduced to
  /// avoid, except here empty is unambiguous because there is no way to
  /// type a category named "all" into a JSON array by accident.
  eligibleCategories           Json     @default("[]")

  /// Minimum PAID orders a customer must already have before the agent
  /// may target them. Zero means every customer is eligible.
  ///
  /// The boundary a merchant reaches for when they do not want an agent
  /// discounting to first-time buyers who would have paid full price.
  minCustomerPaidOrders        Int      @default(0)

  /// How long a proposal remains eligible for policy evaluation at all
  /// after creation (PART 05 §8 `PROPOSAL_EXPIRED`).
  proposalValidityMinutes      Int      @default(30)
  /// How long a human `Approval` remains valid before it can no longer
  /// authorize execution (PART 05 §31).
  approvalValidityMinutes      Int      @default(15)
  /// How long an issued `ExecutionAuthorization` remains `ACTIVE` (PART 05 §42).
  authorizationValidityMinutes Int      @default(10)

  /// PART 18 — how long a merchant's PRICE COMMITMENT stands, in hours.
  ///
  /// Distinct from the three windows above, and deliberately much longer.
  /// Those bound how long an INTERNAL step may sit before it goes stale:
  /// a proposal awaiting evaluation, an approval awaiting use, an
  /// authorization awaiting one checkout. This bounds something a BUYER is
  /// shown and may act on, so minutes would be the wrong unit — an offer
  /// that lapses while someone is deciding is not a boundary, it is a bug.
  ///
  /// Before this existed, `findBuyerVisibleOffers` had no time bound in
  /// reach at all: an offer authorized months earlier was quoted to a
  /// buyer as a live discount, and the only lifetime anywhere near it was
  /// the authorization's ten minutes, which bounds executing one checkout
  /// and says nothing about how long a price stands. Seven days is a
  /// merchant-changeable default, not a rule.
  offerValidityHours           Int      @default(168)
  updatedAt                    DateTime @updatedAt
}

/// A persisted deterministic Policy Engine result (PART 05 §7, §13, §50) —
/// one row per evaluation, never overwritten. The latest row for a given
/// `proposalId` (by `createdAt`) is the authoritative current decision
/// (PART 05 §46); re-evaluation (e.g. after a policy edit) simply appends
/// another row rather than mutating history.
model PolicyEvaluation {
  id                     String               @id @default(uuid())
  proposalId             String
  proposal               GrowthActionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  merchantId             String
  merchant               Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  /// Denormalized from the proposal for convenient ledger correlation
  /// (PART 05 §59: chain ledger events per-workflow).
  workflowId             String
  outcome                PolicyDecision
  reasonCodes            Json
  explanation            String
  evaluatedPolicyVersion Int
  evaluatedValues        Json
  proposalFingerprint    String
  fingerprintVersion     String
  createdAt              DateTime             @default(now())

  approvals               Approval[]
  executionAuthorizations ExecutionAuthorization[]

  @@index([proposalId, createdAt])
  @@index([merchantId, createdAt])
}

/// A human approval DECISION (PART 05 §29-§32) — created only at the
/// moment a merchant actually decides, never at "request" time (the
/// request itself is just the proposal's `PENDING_APPROVAL` status plus an
/// `APPROVAL_REQUESTED` ledger event). Bound to an exact proposal
/// fingerprint: if the underlying proposal's financially meaningful
/// content ever differs from `proposalFingerprint`, this approval can no
/// longer authorize execution (PART 05 §30, §48). At most one `Approval`
/// row exists per `proposalId` — a proposal is decided once.
model Approval {
  id                     String               @id @default(uuid())
  proposalId             String               @unique
  proposal               GrowthActionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalFingerprint    String
  merchantId             String
  merchant               Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  policyEvaluationId     String
  policyEvaluation       PolicyEvaluation     @relation(fields: [policyEvaluationId], references: [id], onDelete: Restrict)
  evaluatedPolicyVersion Int
  decision               ApprovalDecision
  reason                 String?
  /// Server-derived from the authenticated session (PART 10 §1) — never
  /// a client-supplied `approverId` in the request body. Was a fixed
  /// constant string pre-PART-10 (PART 00 §36); now a real
  /// `MerchantUser.id` with referential integrity.
  approverId             String
  approver               MerchantUser         @relation(fields: [approverId], references: [id], onDelete: Restrict)
  createdAt              DateTime             @default(now())
  expiresAt              DateTime

  executionAuthorizations ExecutionAuthorization[]

  @@index([merchantId, createdAt])
}

/// The execution gate (PART 05 §37-§45): "this exact proposal has passed
/// policy and any required approval and is eligible for a later execution
/// layer to attempt execution." NOT itself execution — PART 05 creates no
/// `CONSUMED` rows; that belongs entirely to PART 06. A partial unique
/// index (see the hand-written migration) enforces at most one `ACTIVE`
/// authorization per proposal at the database level, while still allowing
/// historical `EXPIRED`/`REVOKED` rows to accumulate for audit (PART 05 §69).
model ExecutionAuthorization {
  id                   String                       @id @default(uuid())
  proposalId           String
  proposal             GrowthActionProposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalFingerprint  String
  merchantId           String
  merchant             Merchant                     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  policyEvaluationId   String
  policyEvaluation     PolicyEvaluation             @relation(fields: [policyEvaluationId], references: [id], onDelete: Restrict)
  approvalId           String?
  approval             Approval?                    @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  authorizedActionType GrowthActionType
  /// Snapshot of the exact financial bounds this authorization covers
  /// (PART 05 §38) — the future execution layer must never re-derive these
  /// from a possibly-changed proposal.
  financialBounds      Json
  issuedAt             DateTime                     @default(now())
  expiresAt            DateTime
  status               ExecutionAuthorizationStatus @default(ACTIVE)
  authorizationVersion String                       @default("1")
  createdAt            DateTime                     @default(now())

  checkoutSessions CheckoutSession[]

  @@index([proposalId])
  @@index([merchantId, createdAt])
  @@index([status, expiresAt])
}

model Customer {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  displayName String
  email       String?
  segment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  carts            Cart[]
  orders           Order[]
  checkoutSessions CheckoutSession[]

  @@index([merchantId])
}

model Product {
  id                   String               @id @default(uuid())
  merchantId           String
  merchant             Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  description          String
  category             String
  brand                String
  status               ProductStatus        @default(ACTIVE)
  returnPolicySummary  String?
  shippingSummary      String?
  /// PART 02 §57. `UNKNOWN` by default — a merchant must explicitly mark
  /// eligibility, it is never assumed.
  promotionEligibility PromotionEligibility @default(UNKNOWN)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  variants              ProductVariant[]
  relationshipsAsSource ProductRelationship[] @relation("RelationshipSource")
  relationshipsAsTarget ProductRelationship[] @relation("RelationshipTarget")

  @@unique([merchantId, slug])
  @@index([merchantId, category])
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String
  title          String
  priceMinor     Int
  /// Merchant-entered cost of goods. Nullable means UNKNOWN, never zero.
  /// The negotiator fails closed when any item in a proposed bundle has
  /// no cost, because a real margin floor cannot be enforced without it.
  costMinor      Int?
  currency       Currency @default(INR)
  /// Flexible variant attributes (e.g. size, color) — genuinely variable
  /// metadata, per PART 01 §13/§37 ("JSON may be used only where flexible
  /// metadata is genuinely appropriate").
  attributes     Json     @default("{}")
  active         Boolean  @default(true)
  /// PART 02 §20-§21 — distinct from `updatedAt` (which also changes on
  /// attribute/title edits): this specifically tracks when the *price*
  /// was last confirmed, so Price Freshness scoring isn't skewed by
  /// unrelated metadata edits.
  priceUpdatedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, sku])
  @@index([active, priceMinor])
}

model Inventory {
  variantId         String         @id
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  availableQuantity Int            @default(0)
  updatedAt         DateTime       @updatedAt
}

model Cart {
  id         String     @id @default(uuid())
  merchantId String
  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status     CartStatus @default(ACTIVE)
  currency   Currency   @default(INR)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([merchantId, status])
}

model CartItem {
  id                String         @id @default(uuid())
  cartId            String
  cart              Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity          Int
  unitPriceMinor    Int
  /// Non-zero only for the single authorized-offer-eligible line in a
  /// commerce execution (PART 06 §25-§30, §163 — one authorized offer per
  /// checkout, never stacked across lines).
  lineDiscountMinor Int            @default(0)
  currency          Currency       @default(INR)
  /// Closed provenance vocabulary (`@razorgrowth/domain` `OrderSource`) —
  /// PART 06 §15, §63.
  source            String         @default("DIRECT_BUYER")
  /// Set only for a line added/replaced by an authorized Merchant Agent
  /// proposal (PART 06 §55-§60) — never for the buyer's own selection.
  growthProposalId  String?
  createdAt         DateTime       @default(now())

  @@index([cartId])
}

model Order {
  id                 String      @id @default(uuid())
  merchantId         String
  merchant           Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status             OrderStatus @default(PENDING)
  totalAmountMinor   Int
  currency           Currency    @default(INR)
  /// Closed provenance vocabulary (`@razorgrowth/domain` `OrderSource`,
  /// PART 06 §63-§65) for orders created through deterministic commerce
  /// execution. Historical PART 01 seed rows keep a free-form legacy
  /// value (e.g. `"buyer_agent"`) predating this closed vocabulary.
  source             String?
  /// Provenance linkage (PART 06 §64) for future analytics — records
  /// which authorized proposal/authorization produced this order; never
  /// implies a causal revenue claim on its own.
  growthProposalId   String?
  authorizationId    String?
  /// SHA-256 order financial fingerprint (PART 06 §42-§44,
  /// `ORDER_FINGERPRINT_VERSION`) — PART 07 must load this authoritative
  /// value rather than trust any client-submitted amount.
  orderFingerprint   String?
  fingerprintVersion String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items                OrderItem[]
  payments             Payment[]
  /// PART 08 §29, §189 — one-to-many as of PART 08: a bounded recovery
  /// retry creates a new `CheckoutSession` against this SAME order.
  checkoutSessions     CheckoutSession[]
  campaignConversions  CampaignConversion[]
  campaignAttributions CampaignOrderAttribution[]
  refunds              Refund[]
  returnRequests       ReturnRequest[]
  fulfillments         Fulfillment[]
  disputes             Dispute[]

  @@index([merchantId, createdAt])
}

model OrderItem {
  id                   String         @id @default(uuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId            String
  variant              ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  /// Snapshots — an order must remain historically accurate even if the
  /// product/variant is later renamed or repriced (PART 00 §37; PART 01 §14).
  productNameSnapshot  String
  variantTitleSnapshot String
  unitPriceMinor       Int
  quantity             Int
  lineDiscountMinor    Int            @default(0)
  lineTotalMinor       Int
  currency             Currency       @default(INR)
  source               String         @default("DIRECT_BUYER")
  growthProposalId     String?

  returnItems      ReturnItem[]
  fulfillmentItems FulfillmentItem[]

  @@index([orderId])
}

/// RazorGrowth's own internal commerce checkout state (PART 06 §39) —
/// explicitly NOT Razorpay Checkout. PART 06 creates these and stops at
/// `READY_FOR_PAYMENT`; PART 07 owns every later transition.
model CheckoutSession {
  id                 String                  @id @default(uuid())
  merchantId         String
  merchant           Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cartId             String
  cart               Cart                    @relation(fields: [cartId], references: [id], onDelete: Restrict)
  /// PART 08 §29, §189: no longer `@unique` as of PART 08 — a bounded
  /// recovery retry creates a NEW `CheckoutSession` referencing the SAME
  /// (immutable) `Order` and `Cart`, rather than a new Order each attempt
  /// (PART 07's original one-checkout-per-order assumption predates
  /// failure-first recovery). Every attempt's own `CheckoutSession` and
  /// `Payment` row is still preserved permanently — only the mapping from
  /// Order to CheckoutSession became one-to-many.
  orderId            String
  order              Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  authorizationId    String?
  authorization      ExecutionAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  /// External buyer-agent checkouts are authorized by a DecisionRecord,
  /// not a merchant growth proposal. This soft reference is also copied
  /// into Order.authorizationId for the financial fingerprint.
  gatewayDecisionId  String?
  status             CheckoutSessionStatus   @default(CREATED)
  amountMinor        Int
  currency           Currency                @default(INR)
  /// SHA-256 order financial fingerprint, denormalized from `Order` for
  /// convenient independent verification (PART 06 §42-§44).
  orderFingerprint   String
  fingerprintVersion String                  @default("1")
  /// The same workflow the authorizing proposal already established
  /// (PART 05/06 §88) — lets the Agent Action Ledger show one continuous
  /// timeline from proposal through checkout.
  workflowId         String
  createdAt          DateTime                @default(now())
  expiresAt          DateTime
  checkoutVersion    String                  @default("1")

  payments Payment[]

  @@index([merchantId, createdAt])
  @@index([orderId])
  @@index([authorizationId])
  @@index([gatewayDecisionId])
  @@index([status, expiresAt])
}

/// Server-side idempotency for commerce execution (PART 06 §48-§51). A
/// retried request with the SAME key and an unchanged fingerprint returns
/// the persisted `responseSnapshot` without re-executing anything; a
/// changed fingerprint under the same key is a genuine conflict, never
/// silently re-executed.
model IdempotencyRecord {
  id                 String   @id @default(uuid())
  merchantId         String
  merchant           Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  operation          String
  idempotencyKey     String
  requestFingerprint String
  responseSnapshot   Json
  createdAt          DateTime @default(now())

  @@unique([merchantId, operation, idempotencyKey])
}

/// PART 07 §17-§18 — extends the PART 01 placeholder shape into a real
/// payment record. Exactly one `Payment` per `CheckoutSession`
/// (`@@unique([checkoutId])`, enforced at the database level, not just in
/// application code) — PART 07 deliberately does not retry a failed
/// attempt against the same checkout (§93, §114): recovery (PART 08) goes
/// through a brand-new Merchant Agent RECOVERY proposal → policy → a NEW
/// `ExecutionAuthorization` → a NEW `CheckoutSession`, never a second
/// `Payment` row bolted onto the FAILED one directly (PART 08 §8: a
/// failed attempt remains FAILED forever). `attemptNumber` is computed
/// from prior `Payment` rows sharing the same `orderId` (PART 08 §9,
/// §189) — 1 for an order's first attempt, incrementing for each
/// subsequent bounded recovery retry — and `recoveredFromAttemptId`
/// records the immediately-prior attempt's id for lineage.
model Payment {
  id                     String               @id @default(uuid())
  merchantId             String
  merchant               Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderId                String
  order                  Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  checkoutId             String?              @unique
  checkout               CheckoutSession?     @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  attemptNumber          Int                  @default(1)
  provider               PaymentProvider      @default(DEMO)
  /// Razorpay's own order object, created server-side BEFORE the buyer
  /// ever sees a checkout UI (PART 07 §13, §58) — the anchor a webhook or
  /// reconciliation fetch resolves back to this `Payment` row.
  providerOrderId        String?
  /// Set only once a specific payment attempt exists against the provider
  /// order above (PART 07 §17) — a provider order can, in general, receive
  /// more than one payment attempt on Razorpay's side even though this
  /// build only ever expects one.
  providerPaymentId      String?
  amountMinor            Int
  currency               Currency             @default(INR)
  state                  PaymentState         @default(CREATED)
  customerDebitStatus    CustomerDebitStatus  @default(UNKNOWN)
  merchantCreditStatus   MerchantCreditStatus @default(UNKNOWN)
  automaticRetryBlocked  Boolean              @default(false)
  failureCode            String?
  failureCategory        String?
  /// Minimal reconciliation metadata only (PART 07 §62) — never a full
  /// provider payload, never card/UPI instrument details.
  providerMetadata       Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  authorizedAt           DateTime?
  capturedAt             DateTime?
  failedAt               DateTime?
  /// PART 07 §112 — a simple cooldown so `/payments/:id/reconcile` cannot
  /// be hammered; not a production rate limiter.
  lastReconciledAt       DateTime?
  /// PART 08 §9, §189 — the immediately-prior attempt this one recovers
  /// from, when this is not an order's first payment attempt. Self-
  /// referential, `onDelete: SetNull` (lineage is a convenience, never a
  /// reason to block deleting a historical row).
  recoveredFromAttemptId String?
  recoveredFromAttempt   Payment?             @relation("PaymentRecoveryLineage", fields: [recoveredFromAttemptId], references: [id], onDelete: SetNull)
  recoveryAttempts       Payment[]            @relation("PaymentRecoveryLineage")

  providerEvents     PaymentProviderEvent[]
  campaignConversion CampaignConversion?
  refunds            Refund[]
  disputes           Dispute[]

  @@index([orderId])
  @@index([merchantId, state])
  @@index([provider, providerOrderId])
  @@index([provider, providerPaymentId])
  @@index([recoveredFromAttemptId])
  @@index([automaticRetryBlocked])
}

model BuyerSpendingPolicy {
  id                           String          @id @default(uuid())
  customerAccountId            String          @unique
  customerAccount              CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  currency                     Currency        @default(INR)
  autonomousPurchaseLimitMinor Int             @default(200000)
  dailyLimitMinor              Int             @default(1000000)
  allowedCategories            Json            @default("[]")
  /// Explicit "every category is permitted" state.
  ///
  /// The allow-list is matched literally, so a shopper who typed "all"
  /// into the categories field got one category NAMED "all" and every
  /// purchase declined CATEGORY_NOT_ALLOWED — a plausible input that
  /// silently disabled buying. The fix is a real boolean rather than a
  /// magic string: a wildcard hidden inside user-supplied text is exactly
  /// the value an injection would aim for, and an auditor cannot tell a
  /// deliberate "allow everything" from a typo. Defaults to false, so no
  /// existing policy is widened by this column appearing.
  allowAllCategories           Boolean         @default(false)
  approvalRequiredAboveLimit   Boolean         @default(true)

  // ── PART 12 — the boundaries a buyer could not previously express ──
  //
  // Every one of these is enforced in `createPurchaseProposal`, the single
  // function both the HTTP route and the Buyer Agent conversation call.
  // There is no second place a purchase can be priced, so there is no
  // second place these can be skipped.

  /// HARD ceiling. A purchase above this is DECLINED outright, never sent
  /// for approval.
  ///
  /// Distinct from `autonomousPurchaseLimitMinor`, which is the point
  /// above which the buyer is ASKED. Two different questions: "how much
  /// may the agent spend without me" and "how much am I willing to spend
  /// at all". Collapsing them would mean a buyer could only raise their
  /// convenience threshold by also raising their exposure.
  ///
  /// Defaults high enough not to change any existing buyer's outcome — a
  /// column appearing must never silently start refusing purchases that
  /// worked yesterday.
  maxPurchaseAmountMinor       Int             @default(100000000)

  /// Categories the agent may NEVER buy from, whatever else permits them.
  ///
  /// A denylist rather than the absence of an allow, and it BEATS
  /// `allowedCategories` and `allowAllCategories` both — a prohibition
  /// must survive someone later widening the allow list, or it was never
  /// a prohibition.
  ///
  /// string[] of category names. Empty means nothing is restricted.
  restrictedCategories         Json            @default("[]")

  /// Categories the buyer leans toward. A RANKING SIGNAL, NEVER A GATE.
  ///
  /// Stated explicitly because the obvious next change is to "enforce"
  /// it, and that would silently convert a preference into a restriction
  /// — a buyer who said "I prefer running shoes" has not said "refuse to
  /// show me anything else".
  preferredCategories          Json            @default("[]")

  /// Whether the agent may complete a purchase without asking at all.
  ///
  /// Off turns every purchase into a step-up, however small — the buyer
  /// wants to see each one. Defaults TRUE because that is the behaviour
  /// every existing buyer already has: under the autonomous limit,
  /// purchases auto-approve. A false default would change what the
  /// product does for people who never asked for a change.
  autoPurchaseEnabled          Boolean         @default(true)

  /// Merchants the agent may never buy from. Same denylist reasoning as
  /// `restrictedCategories`: a buyer who has had a bad experience with a
  /// seller should be able to say so once and have it hold.
  ///
  /// string[] of merchant ids. Empty means no merchant is restricted.
  restrictedMerchantIds        Json            @default("[]")

  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
}

/// PART 07 §25, §85, §147 — persisted record of one provider (webhook)
/// event, independent of whether it could be resolved to a `Payment`.
/// `eventFingerprint` (not the raw provider event ID, which Razorpay does
/// not guarantee as a stable top-level field on every event type — PART
/// 07 §32) is a deterministic hash of the event's stable identifying
/// fields plus the raw payload hash; a database-level unique constraint
/// on it is what makes duplicate delivery idempotent (§23, §31, §87-§88),
/// not a timestamp check.
model PaymentProviderEvent {
  id                String                       @id @default(uuid())
  /// Nullable (PART 10 §1): a webhook is authenticated by HMAC signature,
  /// never a merchant session, so the owning merchant is only knowable
  /// AFTER the event's `providerOrderId` resolves to a real `Payment`
  /// row. A genuinely unresolvable event (unknown order, no payment
  /// entity) has no merchant to attribute it to — this is now an honest
  /// `NULL`, not a value borrowed from whichever merchant happened to be
  /// the single demo tenant.
  merchantId        String?
  merchant          Merchant?                    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  provider          PaymentProvider              @default(RAZORPAY)
  providerEventId   String?
  eventType         String
  paymentId         String?
  payment           Payment?                     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  providerPaymentId String?
  providerOrderId   String?
  eventFingerprint  String
  payloadHash       String
  signatureVerified Boolean
  processingStatus  PaymentEventProcessingStatus @default(RECEIVED)
  receivedAt        DateTime                     @default(now())
  processedAt       DateTime?

  @@unique([provider, eventFingerprint])
  @@index([merchantId, receivedAt])
  @@index([paymentId])
}

/// Agent Action Ledger foundation (PART 00 §20, §38; PART 01 §17).
/// `conciseReason` is an auditable explanation, never hidden
/// chain-of-thought.
/// PART 05 §57-§63 adds a lightweight, application-level tamper-evident
/// hash chain, scoped per `workflowId` (never one global chain — §59: that
/// would add locking/concurrency complexity with no real benefit here).
/// `sequence` is 1-indexed and assigned transactionally by the centralized
/// `appendLedgerEvent` writer (`modules/audit/ledger.ts`) — never by ad hoc
/// inserts — so `@@unique([workflowId, sequence])` can never be violated by
/// a race. `eventHash = SHA256(canonicalEventData + previousEventHash)`;
/// `previousEventHash` is null only for `sequence = 1`. This is explicitly
/// NOT a blockchain (PART 05 §63, §130) — it detects accidental or
/// malicious alteration of already-written rows, nothing more.
model AgentAction {
  id                String            @id @default(uuid())
  workflowId        String
  agentRunId        String?
  merchantId        String
  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  actorType         AgentActorType
  actionType        String
  status            AgentActionStatus @default(PROPOSED)
  conciseReason     String
  policyDecision    PolicyDecision?
  relatedEntityType String?
  relatedEntityId   String?
  metadata          Json?
  sequence          Int
  previousEventHash String?
  eventHash         String
  ledgerHashVersion String            @default("1")
  isSyntheticDemo   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  executedAt        DateTime?

  @@unique([workflowId, sequence])
  @@index([workflowId])
  @@index([merchantId, createdAt])
  @@index([actorType])
  @@index([status])
  @@index([eventHash])
}

/// Deterministic, explainable readiness scoring (PART 00 §18; PART 01
/// §18; PART 02 §30-§50). Calculated by `AgenticReadinessEngine` from
/// real catalog/policy/inventory evidence via `CatalogQualityAnalyzer` —
/// never LLM-generated (PART 02 §31). Stores the full dimension
/// breakdown, evidence, and blockers so a historical score can always be
/// explained, not just displayed as a bare number.
model ReadinessSnapshot {
  id                   String                 @id @default(uuid())
  merchantId           String
  merchant             Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  overallScore         Int
  level                MerchantReadinessLevel
  catalogCompleteness  Int
  aiDiscoverability    Int
  priceFreshness       Int
  inventoryReliability Int
  policyCompleteness   Int
  checkoutReadiness    Int
  paymentReliability   Int
  metadataQuality      Int
  trustInformation     Int
  weakestDimension     String
  strongestDimension   String
  /// Array of deterministic recommendation strings (see
  /// `@razorgrowth/domain` `deriveReadinessRecommendations`).
  recommendations      Json
  /// Array of `ReadinessBlocker` objects (PART 02 §37), already
  /// prioritized by `prioritizeBlockers`.
  blockers             Json
  /// Short list of dimension strengths worth surfacing in the UI.
  strengths            Json
  /// Evidence counters the engine used to compute this snapshot (e.g.
  /// activeProducts, missingReturnPolicies) — PART 02 §32, §46: scoring
  /// must be evidence-first, and the evidence must be inspectable, not
  /// just the resulting number.
  evidence             Json
  /// PART 02 §50 — `@razorgrowth/domain` `READINESS_MODEL_VERSION`, so a
  /// stored score is never misread against a different formula version.
  calculationVersion   String
  isSyntheticDemo      Boolean                @default(true)
  createdAt            DateTime               @default(now())

  @@index([merchantId, createdAt])
}

/// Buyer Agent conversation state (PART 03 §50, §112-§113). Intentionally
/// minimal per PART 00 §36 identity simplification — no buyer/customer
/// login, one anonymous conversation per browser session, scoped to the
/// single demo merchant.
model BuyerConversation {
  id                String                  @id @default(uuid())
  /// The SHOPPER, never the seller. A marketplace conversation may reach
  /// several merchants' catalogues or none; which merchant it reached is
  /// recorded on the RecommendationRecord it produced, which is the only
  /// honest way to ask "how many buyer conversations reached me?".
  customerAccountId String
  customerAccount   CustomerAccount         @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  status            BuyerConversationStatus @default(ACTIVE)
  /// The proposal THIS conversation last priced and is waiting on.
  ///
  /// PART 10: without it, "yes" resolved against the most recent pending
  /// proposal for the BUYER rather than for this conversation — so an
  /// affirmation in a fresh conversation could authorize a purchase that
  /// had been quoted somewhere else entirely. A buyer saying yes means
  /// the thing the agent just showed *them*, and this is the only column
  /// that can say which thing that was.
  ///
  /// Cleared the moment it is authorized, so one yes buys one thing.
  pendingProposalId String?
  /// Normalized `BuyerIntent` snapshot (validated + normalized shape,
  /// PART 03 §11, §25-§26) — never raw, unvalidated model output.
  currentIntent     Json?
  /// The audit workflow this whole conversation writes into.
  ///
  /// PART 13: the ledger workflow id used to be the per-TURN `traceId`,
  /// so a buyer who searched in one turn and bought in another produced
  /// several unrelated hash chains. The pipeline the product promises —
  /// INTENT → DISCOVERY → COMPARISON → RECOMMENDATION → OFFER CHECK →
  /// POLICY → AUTHORIZATION → CHECKOUT → PAYMENT → ORDER — spans turns
  /// by definition, so a per-turn workflow could never contain it, and
  /// the buyer's own activity showed one journey as several disconnected
  /// cards with nothing joining the recommendation to the charge.
  ///
  /// `traceId` still exists and is still per-turn: it is a REQUEST
  /// correlation id for logs and the response, which is a different thing
  /// from a workflow and was only ever doing this job by accident.
  ///
  /// Nullable so existing conversations keep working; a conversation
  /// without one falls back to the turn's traceId, exactly as before.
  workflowId        String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  messages        BuyerMessage[]
  recommendations RecommendationRecord[]

  @@index([customerAccountId, updatedAt])
  @@index([workflowId])
}

model BuyerMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   BuyerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           BuyerMessageRole
  content        String
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

/// A durable record of one recommendation cycle (PART 03 §69, §113) —
/// compact, auditable metadata only. Never stores hidden chain-of-thought
/// or full raw provider payloads (PART 03 §27, §67).
model RecommendationRecord {
  id                    String            @id @default(uuid())
  conversationId        String
  conversation          BuyerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  merchantId            String
  merchant              Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  intentSnapshot        Json
  /// string[] of product IDs supplied to ranking as the bounded candidate
  /// set (PART 03 §31, §95 — "0 recommendations outside the candidate set").
  candidateProductIds   Json
  /// string[] of product IDs in final rank order, after grounding.
  recommendedProductIds Json
  /// string[] of the SPECIFIC variant id recommended for each product
  /// above, same order, same length — parallel to `recommendedProductIds`
  /// rather than folded into it, so every existing reader that treats that
  /// column as a flat string[] of product ids (the revenue-opportunity SQL,
  /// the Merchant Agent's eligibility check) keeps working unchanged.
  ///
  /// PART 09: without this, "buy it" on a later turn had no record of
  /// WHICH variant (size, colour) had actually been shown, and silently
  /// substituted the product's cheapest active variant instead — which
  /// can be a different size or colour than the one the buyer was looking
  /// at. Defaults to an empty array so historical rows degrade to that same
  /// prior behaviour rather than erroring.
  recommendedVariantIds Json     @default("[]")
  /// e.g. AI_RANKED / DETERMINISTIC_SINGLE_MATCH / DETERMINISTIC_FALLBACK /
  /// NEAR_MATCH / NO_MATCH (PART 03 §160).
  mode                  String
  aiProviderMode        String
  traceId               String
  createdAt             DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@index([merchantId, createdAt])
}

/// Merchant-configured growth boundaries (PART 04 §21-§23) — a singleton
/// per merchant. These bound what the Merchant Agent may even PROPOSE;
/// PART 05's Policy Engine separately decides what may actually proceed
/// (PART 04 §22: "Merchant Agent boundary <= Policy boundary", defense in
/// depth). The agent itself can never modify this row.
model MerchantGrowthConfig {
  merchantId             String   @id
  merchant               Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  growthActionsEnabled   Boolean  @default(true)
  /// Whether this merchant permits the agent to run cycles UNATTENDED.
  /// False by default: a merchant is never opted in by a deployment, and
  /// the operator's own AGENT_SCHEDULER_ENABLED must be set as well.
  /// Nothing about a scheduled cycle relaxes policy — it is the same run
  /// the merchant triggers by hand.
  autonomousRunsEnabled  Boolean  @default(false)
  crossSellEnabled       Boolean  @default(true)
  upsellEnabled          Boolean  @default(true)
  bundleEnabled          Boolean  @default(true)
  boundedOffersEnabled   Boolean  @default(true)
  maxUpsellIncreaseBps   Int      @default(1500)
  maxProposedDiscountBps Int      @default(1000)
  maxCrossSellItems      Int      @default(3)
  maxBundleItems         Int      @default(2)
  currency               Currency @default(INR)
  updatedAt              DateTime @updatedAt
}

/// Deterministic product-relationship model (PART 04 §24-§25). The
/// Merchant Agent's bounded candidate set is generated FROM these rows —
/// it never searches the whole catalog. Directional (source -> target);
/// a bidirectional pairing (e.g. shoes<->socks bundle) is represented by
/// two rows, not implied.
model ProductRelationship {
  id               String                  @id @default(uuid())
  merchantId       String
  merchant         Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sourceProductId  String
  sourceProduct    Product                 @relation("RelationshipSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProductId  String
  targetProduct    Product                 @relation("RelationshipTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  relationshipType ProductRelationshipType
  provenance       RelationshipProvenance  @default(DEMO_SEED)
  createdAt        DateTime                @default(now())

  @@unique([sourceProductId, targetProductId, relationshipType])
  @@index([merchantId, sourceProductId])
}

/// A durable record of one Merchant Agent growth proposal (PART 04 §16,
/// §114). Compact, auditable metadata only — never hidden chain-of-
/// thought (PART 04 §148). `policyStatus` is always "NOT_EVALUATED" here;
/// PART 05 owns real policy/approval. A validated proposal is NOT
/// execution authorization (PART 04 §149) — future layers must
/// revalidate authoritative commerce state before any money-affecting
/// action.
model GrowthActionProposal {
  id                       String               @id @default(uuid())
  merchantId               String
  merchant                 Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  conversationId           String?
  recommendationId         String?
  primaryProductId         String
  actionType               GrowthActionType?
  relatedProductIds        Json
  offerKind                OfferKind?
  offerPercentageBps       Int?
  offerAmountMinor         Int?
  offerCurrency            Currency?
  offerCalculation         Json?
  opportunity              Json?
  evidence                 Json
  reasonCodes              Json
  explanation              String
  mode                     GrowthProposalMode
  status                   GrowthProposalStatus
  rejectionReason          String?
  blockedOpportunities     Json
  traceId                  String
  /// PART 08 §19, §188 — set only for a payment-failure recovery proposal
  /// (`actionType: RECOVERY`, distinguishing it from PART 04's buyer-
  /// budget `RECOVERY` variant, which never sets these). Soft pointers,
  /// same "provenance linkage, never a hard FK" convention already used
  /// for `Order.growthProposalId`/`authorizationId` (PART 06 §64) — the
  /// source Order/Payment/CheckoutSession are immutable historical
  /// records this proposal references, never mutates.
  recoveryAction           String?
  sourceOrderId            String?
  sourcePaymentId          String?
  sourceCheckoutId         String?
  /// Denormalized pointers to the latest governance records (PART 05),
  /// updated transactionally alongside `status` — plain soft references,
  /// same convention as `conversationId`/`recommendationId` above, so a
  /// proposal read never needs a separate join for the common case.
  latestPolicyDecisionId   String?
  approvalId               String?
  executionAuthorizationId String?
  /// PART 18 — when this offer stops being quotable to a buyer, stamped
  /// from the merchant's `offerValidityHours` when the offer is created.
  ///
  /// NULL means no window was recorded, which is every offer authorized
  /// before this column existed. Those are treated as still standing
  /// rather than as expired: a merchant committed to them under rules
  /// that had no expiry, and retroactively revoking a commitment because
  /// a column was added later would be the system changing its mind about
  /// a price on the merchant's behalf.
  offerValidUntil          DateTime?
  isSyntheticDemo          Boolean              @default(true)
  createdAt                DateTime             @default(now())

  policyEvaluations       PolicyEvaluation[]
  approval                Approval?
  executionAuthorizations ExecutionAuthorization[]

  @@index([merchantId, createdAt])
  @@index([conversationId])
  @@index([sourceOrderId])
}

// ─────────────────────────────────────────────────────────────────────────
// VAANIGAM GATEWAY — agent-facing commerce
//
// Everything below serves one question: can an AI agent this merchant has
// never seen buy from them safely, whatever protocol it speaks? The
// governance records above (PolicyEvaluation, Approval,
// ExecutionAuthorization, AgentAction) are reused unchanged — a gateway
// intent that clears both checks flows into exactly the same execution and
// ledger path as any other action.
// ─────────────────────────────────────────────────────────────────────────

enum AgentProtocol {
  ACP
  AP2
  X402
  UAP
  UCP
}

enum AgentTrustLevel {
  KNOWN
  UNKNOWN
}

enum GatewayDecisionOutcome {
  AUTO_APPROVE
  STEP_UP
  DECLINE
}

/// A buyer agent this merchant has encountered. Trust is derived from the
/// merchant's OWN record of settled orders, never from anything the agent
/// asserts about itself — an agent claiming to be trusted is precisely the
/// case the unknown-agent ceiling exists to catch.
model AgentIdentity {
  id                String        @id @default(uuid())
  merchantId        String
  merchant          Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  /// Stable identifier the agent presents (x-agent-id / payload agent id).
  externalAgentId   String
  displayName       String?
  /// Protocol first seen on. Informational: an agent may switch protocols
  /// without becoming a different counterparty.
  firstSeenProtocol AgentProtocol
  settledOrderCount Int           @default(0)

  /// The Ed25519 public key this merchant trusts for this agent.
  ///
  /// Mandate signatures are verified against THIS, never against the key
  /// inside the request. Null means no key is on file and a signed mandate
  /// from this agent cannot be verified against anything trusted.
  registeredPublicKey String?
  /// How the key came to be trusted. `MERCHANT_REGISTERED` is an explicit,
  /// authenticated act. `PINNED_ON_FIRST_USE` is trust-on-first-use: it
  /// bounds an unknown agent to the unknown-agent ceiling and refuses any
  /// later key change, but it is NOT a PKI and is labelled as such.
  keyTrustSource      String?
  keyRegisteredAt     DateTime?

  /// SHA-256 of the API credential this agent presents on ACP routes.
  /// Hashed, never stored raw — same treatment as a user session token.
  apiKeyHash      String?
  apiKeyIssuedAt  DateTime?
  apiKeyRevokedAt DateTime?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  decisionRecords   DecisionRecord[]
  delegatedPayments AcpDelegatedPayment[]

  @@unique([merchantId, externalAgentId])
  @@index([merchantId, lastSeenAt])
}

/// Spent mandate nonces. A mandate is single-use: presence of a row here
/// means "already spent", which is what makes replay detectable even while
/// the mandate is still inside its validity window.
///
/// Unique on (merchantId, nonce) rather than nonce alone — a nonce is only
/// meaningful within the merchant scope the mandate was signed for, and a
/// global unique would let one merchant's traffic burn another's.
model SpendMandateNonce {
  id           String   @id @default(uuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  nonce        String
  mandateId    String
  buyerAgentId String
  spentAt      DateTime @default(now())

  @@unique([merchantId, nonce])
  @@index([merchantId, spentAt])
}

/// Per-merchant configuration for autonomous agent purchasing.
///
/// Kept separate from `MerchantPolicy` on purpose: that governs what the
/// merchant's OWN agents may propose, this governs what OUTSIDE agents may
/// buy. Merging them would make a single version bump mean two unrelated
/// things.
model AgentGatewayPolicy {
  id                        String   @id @default(uuid())
  merchantId                String   @unique
  merchant                  Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  policyVersion             Int      @default(1)
  currency                  Currency @default(INR)
  /// Ceiling for an agent with no settled orders with this merchant.
  unknownAgentCeilingMinor  Int      @default(1000000)
  /// Ceiling for an agent that has settled before.
  knownAgentCeilingMinor    Int      @default(5000000)
  /// Categories no agent may buy autonomously, at any value.
  blockedCategories         String[] @default([])
  /// Hard cap on what the negotiator may ever offer. Enforced in code,
  /// never by the model.
  maxNegotiationDiscountBps Int      @default(1000)
  /// The negotiator only engages on baskets SMALLER than this. Upselling
  /// someone who already filled a basket is discounting a sale you had.
  negotiatorMinBundleItems  Int      @default(2)
  /// Floor margin, in basis points. An offer that would take the basket
  /// below it is rejected outright rather than clamped — clamping a
  /// margin breach would still sell below cost, just by less.
  negotiatorFloorMarginBps  Int      @default(2000)
  velocityMaxIntentsPerHour Int      @default(20)
  /// Whether an unseen agent's first key may be pinned automatically.
  ///
  /// OFF by default, because trust-on-first-use guarantees continuity, not
  /// first-contact authenticity. With it off, an agent must be enrolled by
  /// an authenticated merchant user before any signed mandate it presents
  /// can be verified against anything trusted.
  allowFirstUseKeyPinning   Boolean  @default(false)

  /// ── Customer negotiation ────────────────────────────────────────
  ///
  /// A shopper asking for a better price is answered by code reading
  /// their own settled history, not by a person and not by a model.
  ///
  /// Above `negotiationAutoApplyCeilingBps` the request goes to the
  /// merchant instead of applying. Past `negotiationMaxDiscountBps` the
  /// answer is simply no — there is no point troubling a human with a
  /// number they have already said they will never accept.
  negotiationAutoApplyCeilingBps Int     @default(500)
  negotiationMaxDiscountBps      Int     @default(1500)
  /// The rupee stop, and the reason this is safe to automate at all.
  ///
  /// A percentage is not a limit on a large basket: 5% of a ₹5,00,000
  /// order is ₹25,000 handed over with nobody in the loop. Whatever the
  /// percentage works out to, an automatic discount may not exceed this
  /// absolute amount — past it, a human decides.
  negotiationMaxAutoApplyMinor   Int     @default(200000)
  /// Off switch. With this false, every request goes to the merchant.
  negotiationAutomationEnabled   Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// An ACP checkout session, persisted because the protocol is stateful:
/// an agent creates a session, updates it, then completes it, and each
/// call must see what the previous one did.
///
/// Status values are ACP's own strings rather than an enum — the spec
/// version is pinned in `ACP_API_VERSION`, and inventing our own
/// vocabulary here would mean translating twice for no benefit.
model AcpCheckoutSession {
  id               String   @id
  merchantId       String
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  status           String
  currency         String
  lineItems        Json
  totalAmountMinor Int
  buyerEmail       String?
  buyerName        String?
  /// ACP's own spend-authorisation object, stored as received.
  allowance        Json?
  /// Risk signals the calling platform supplied. Persisted on the SESSION
  /// because they arrive at create time but are only acted on at
  /// completion — dropping them in between would silently discard the
  /// platform's own fraud judgement.
  riskSignals      Json?
  externalAgentId  String?
  /// The gateway decision this session most recently produced.
  decisionRecordId String?

  /// ACP `CheckoutSessionBase.messages` — the protocol's own channel for
  /// telling the CALLING AGENT why something did not simply go through.
  ///
  /// Persisted rather than recomputed on read so a later GET on the
  /// session returns the same messages the completion returned. An agent
  /// that polls must not see the reason change under it.
  messages  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delegatedPayments AcpDelegatedPayment[]

  @@index([merchantId, createdAt])
}

/// A server-issued ACP delegated-payment authorization. The external
/// payment-method token itself is never stored: only a keyed HMAC fingerprint
/// is retained, while the client receives a signed Vaanigam token that is
/// bound to this row, merchant, authenticated agent and optional session.
model AcpDelegatedPayment {
  id                           String              @id
  merchantId                   String
  merchant                     Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  agentIdentityId              String
  agentIdentity                AgentIdentity       @relation(fields: [agentIdentityId], references: [id], onDelete: Cascade)
  checkoutSessionId            String?
  checkoutSession              AcpCheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  paymentMethodType            String
  paymentInstrumentFingerprint String
  allowance                    Json
  riskSignals                  Json?
  status                       String              @default("ACTIVE")
  expiresAt                    DateTime
  consumedAt                   DateTime?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  @@index([merchantId, createdAt])
  @@index([agentIdentityId, status])
  @@index([checkoutSessionId])
  @@index([status, expiresAt])
}

/// Immutable output of one catalogue compilation. Compilation is a draft;
/// only an explicit OWNER publish changes the live catalogue. A published
/// version stores the exact before-image needed for deterministic rollback.
model CatalogCompilation {
  id                String    @id @default(uuid())
  merchantId        String
  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  status            String    @default("DRAFT")
  rowsRead          Int
  rowsCompiled      Int
  issues            Json
  products          Json
  providerMode      String
  beforeSnapshot    Json?
  appliedProductIds String[]  @default([])
  publishedAt       DateTime?
  rolledBackAt      DateTime?
  createdAt         DateTime  @default(now())

  @@index([merchantId, createdAt])
  @@index([merchantId, status])
}

/// Bounded campaign orchestration. Cohort assignment is deterministic and
/// persisted; CONTROL members never receive a money-changing proposal.
model Campaign {
  id                          String   @id @default(uuid())
  merchantId                  String
  merchant                    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name                        String
  status                      String   @default("DRAFT")
  actionType                  String
  budgetMinor                 Int
  spentMinor                  Int      @default(0)
  incentiveMinorPerConversion Int      @default(0)
  maxUsesPerSubject           Int      @default(1)
  controlPercentBps           Int      @default(1000)
  startsAt                    DateTime
  endsAt                      DateTime
  createdById                 String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  assignments  CampaignAssignment[]
  conversions  CampaignConversion[]
  attributions CampaignOrderAttribution[]

  @@index([merchantId, status])
  @@index([startsAt, endsAt])
}

model CampaignAssignment {
  id                   String   @id @default(uuid())
  campaignId           String
  campaign             Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subjectKeyHash       String
  cohort               String
  impressionCount      Int      @default(0)
  conversionCount      Int      @default(0)
  observedRevenueMinor Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  conversions  CampaignConversion[]
  attributions CampaignOrderAttribution[]

  @@unique([campaignId, subjectKeyHash])
  @@index([campaignId, cohort])
}

/// Immutable pre-capture evidence that a treatment assignment was bound to
/// a specific order before conversion. An order can belong to only one
/// campaign attribution, preventing retroactive revenue shopping.
model CampaignOrderAttribution {
  id           String             @id @default(uuid())
  campaignId   String
  campaign     Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   CampaignAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  orderId      String             @unique
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  boundAt      DateTime           @default(now())

  conversion CampaignConversion?

  @@index([campaignId, boundAt])
  @@index([assignmentId, boundAt])
}

/// Revenue attribution backed by a captured internal payment. A payment
/// can appear once, so retries cannot inflate campaign results.
model CampaignConversion {
  id                   String                    @id @default(uuid())
  campaignId           String
  campaign             Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignmentId         String
  assignment           CampaignAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  paymentId            String                    @unique
  payment              Payment                   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderId              String
  order                Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attributionId        String?                   @unique
  attribution          CampaignOrderAttribution? @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  incentiveCostMinor   Int
  observedRevenueMinor Int
  createdAt            DateTime                  @default(now())

  @@index([campaignId, createdAt])
  @@index([assignmentId])
  @@index([orderId])
}

/// The immutable explainability artifact: one row per inbound intent,
/// approved, upsold, stepped up or declined.
///
/// Every row carries a plain-English `explanation` written for a merchant,
/// not a status code alone — the brief's bar is that no decision is
/// recorded without a sentence, and making the column non-nullable is how
/// that bar is enforced rather than merely intended.
model DecisionRecord {
  id              String         @id @default(uuid())
  merchantId      String
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  agentIdentityId String?
  agentIdentity   AgentIdentity? @relation(fields: [agentIdentityId], references: [id], onDelete: SetNull)

  protocol        AgentProtocol?
  protocolVersion String?
  /// Null when the request never identified a protocol we speak — the
  /// decline still gets a record, because an unreadable request is
  /// exactly the kind of thing a merchant should be able to see.
  detectedVia     String?

  externalAgentId String?
  agentTrust      AgentTrustLevel?

  outcome     GatewayDecisionOutcome
  reasonCode  String
  /// Required. A decision without a sentence cannot be written.
  explanation String

  /// Server-computed from the catalogue. The agent's own figure is stored
  /// beside it precisely so a disagreement is visible after the fact.
  computedTotalMinor  Int?
  claimedTotalMinor   Int?
  appliedCeilingMinor Int?
  currency            Currency?

  /// The adaptive trust score (0-100) behind `appliedCeilingMinor`, and
  /// the band it fell in. Snapshotted per decision rather than read live
  /// from the agent: the console must be able to show the score AS IT WAS
  /// when the call was made, not as it is now. A later attack must not
  /// silently rewrite the reason an earlier order was approved.
  ///
  /// Null on historical rows and on any decision the flat known/unknown
  /// binary made.
  trustScoreAtDecision Int?
  trustBandAtDecision  String?

  /// Set when the negotiator offered something. Always within
  /// `AgentGatewayPolicy.maxNegotiationDiscountBps`.
  negotiatedDiscountBps Int?

  /// ── Customer-initiated negotiation ──────────────────────────────
  ///
  /// What the shopper ASKED for, kept beside what was granted. A record
  /// that stores only the outcome cannot answer "did we give them what
  /// they wanted?", which is the first question anyone asks of a
  /// negotiation after the fact.
  negotiationRequestedBps  Int?
  /// AUTO_APPLIED | PENDING_MERCHANT | MERCHANT_APPROVED |
  /// MERCHANT_REJECTED | DECLINED. Null when nobody negotiated.
  negotiationStatus        String?
  /// The plain-English answer the shopper was given. Stored rather than
  /// recomputed so it can never drift from the decision it explained.
  negotiationExplanation   String?
  /// The loyalty tier that produced the entitlement, snapshotted. A
  /// customer's later refund must not rewrite why an earlier discount
  /// was granted.
  customerTierAtDecision   String?
  /// The basket total BEFORE any discount was applied.
  ///
  /// Without this the amount given away is unrecoverable: once
  /// `computedTotalMinor` is reduced, nothing records what it was reduced
  /// from, and a merchant auditing their own margin has no baseline.
  preNegotiationTotalMinor Int?

  /// What the MODEL actually proposed, before any clamping or grounding.
  ///
  /// Stored beside the enforced outcome on purpose. The claim "the LLM
  /// cannot move money" is only checkable if the model's raw output
  /// survives next to what the system did with it — otherwise a reader
  /// has to take the clamp on trust. When the two differ, that row IS the
  /// evidence the guardrail did something.
  ///
  /// Shape: `{ discountBps, addSkus, pitch, clampedDiscount, droppedSkus }`.
  /// Null when no negotiation ran, which is the common case.
  negotiatorRawProposal Json?

  /// Legacy nullable fields retained for historical rows. New step-ups are
  /// approved first and only then create a bounded provider order.
  stepUpPaymentLinkId  String?
  stepUpPaymentLinkUrl String?

  /// The buyer the agent is acting for, when the protocol carried one.
  /// ACP and AP2 both supply it; x402 generally does not, so it is nullable
  /// rather than faked.
  buyerEmail String?
  buyerName  String?

  /// Structurally faithful but privacy-redacted input. Credentials, payment
  /// tokens and buyer PII are removed before persistence; commercial and
  /// protocol fields remain available for explainability.
  rawProtocolPayload Json?

  /// Which kind of spend permission was actually verified.
  ///
  /// SIGNED_MANDATE  - Ed25519 signature checked against the terms.
  /// UNSIGNED_ALLOWANCE - an ACP Allowance, checked on amount/currency/
  ///   expiry/scope but NOT cryptographically. Recorded distinctly because
  ///   describing it as a verified mandate would overstate what happened.
  /// NONE - refused before any permission applied.
  permissionType              String?
  authorizationExpiresAt      DateTime?
  authorizationMaxAmountMinor Int?
  authorizationCurrency       Currency?
  authorizationMerchantScope  String?

  /// The source protocol's own identifier for this exchange (an ACP
  /// checkout_session_id, an x402 nonce), so a decision can be traced back
  /// into the counterparty's system.
  protocolActorRef String?

  /// Set when an AUTO_APPROVE created a real Razorpay order (test mode).
  /// An approved intent has to become something the agent can actually pay,
  /// otherwise the gateway only ever decides and never transacts. Nullable
  /// because a decline never reaches the provider, and because a provider
  /// outage must not lose the decision that was already made.
  providerOrderId     String?
  providerPaymentId   String?
  settlementStatus    String?
  settledAt           DateTime?
  internalOrderId     String?
  internalPaymentId   String?
  inventoryReleasedAt DateTime?
  /// Normalized server-priced lines needed to execute a human-approved
  /// step-up. This is commercial data only, never raw protocol input.
  normalizedBasket    Json?

  /// Soft references into the existing governance chain, so a gateway
  /// decision that proceeded can be walked exactly like any other action.
  growthProposalId         String?
  executionAuthorizationId String?
  workflowId               String?

  /// A step-up is a request for a HUMAN decision, so it has one.
  ///
  /// Previously a step-up produced only a Razorpay Payment Link handed
  /// back to the buyer agent. Paying a link is not merchant approval: the
  /// buyer completing a payment they chose to complete proves nothing
  /// about whether the merchant wanted the sale. These record the actual
  /// decision, by an authenticated OWNER/APPROVER.
  stepUpStatus       String? /// PENDING | APPROVED | REJECTED
  stepUpDecidedById  String?
  stepUpDecidedAt    DateTime?
  stepUpDecisionNote String?

  /// Wall-clock time from request receipt to decision, for the console's
  /// median-latency figure. Measured, never estimated.
  decisionLatencyMs Int

  createdAt DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([merchantId, outcome])
  /// The adaptive trust score aggregates an agent's declines and
  /// attack-shaped decisions on every gateway call. Without this that is a
  /// scan of the entire decision history per request.
  @@index([agentIdentityId, reasonCode])
  /// Merchants reviewing negotiations that are waiting on them.
  @@index([merchantId, negotiationStatus])
  @@index([agentIdentityId])
  @@index([providerOrderId])
}

model Refund {
  id               String   @id @default(uuid())
  merchantId       String
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountMinor      Int
  currency         Currency @default(INR)
  status           String   @default("PROCESSED")
  reason           String?
  providerRefundId String?
  restockInventory Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([merchantId, createdAt])
  @@index([paymentId])
  @@index([orderId])
}

model ReturnRequest {
  id                String   @id @default(uuid())
  merchantId        String
  merchant          Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            String   @default("REQUESTED")
  reason            String
  inspectionNotes   String?
  restocked         Boolean  @default(false)
  refundAmountMinor Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items ReturnItem[]

  @@index([merchantId, createdAt])
  @@index([orderId])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity        Int
  reason          String?
  createdAt       DateTime      @default(now())

  @@index([returnRequestId])
}

model Fulfillment {
  id                  String    @id @default(uuid())
  merchantId          String
  merchant            Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderId             String
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status              String    @default("PENDING")
  trackingNumber      String?
  carrier             String?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  estimatedDeliveryAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items FulfillmentItem[]

  @@index([merchantId, createdAt])
  @@index([orderId])
}

model FulfillmentItem {
  id            String      @id @default(uuid())
  fulfillmentId String
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity      Int
  createdAt     DateTime    @default(now())

  @@index([fulfillmentId])
}

model Dispute {
  id                  String    @id @default(uuid())
  merchantId          String
  merchant            Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentId           String
  payment             Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId             String
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerDisputeId   String?
  amountMinor         Int
  currency            Currency  @default(INR)
  status              String    @default("OPEN")
  reason              String
  evidenceText        String?
  evidenceSubmittedAt DateTime?
  feeMinor            Int       @default(0)
  openedAt            DateTime  @default(now())
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([merchantId, createdAt])
  @@index([paymentId])
  @@index([orderId])
}
